generator client {
  provider            = "prisma-client"
  output              = "../.opensaas/prisma-client"
  importFileExtension = "ts"
  moduleFormat        = "esm"
}

datasource db {
  provider = "sqlite"
}

model User {
  id       String    @id @default(cuid())
  name     String
  email    String    @unique
  articles Article[]
}

model Article {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     Json
  excerpt     Json?
  publishedAt DateTime?
  authorId    String?   @map("author")
  author      User?     @relation(fields: [authorId], references: [id])

  @@index([authorId])
}
