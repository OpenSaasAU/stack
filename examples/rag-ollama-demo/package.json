{
  "name": "opensaas-rag-ollama-example",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "opensaas dev",
    "build": "pnpm generate && next build",
    "clean": "rm -rf .turbo .next .opensaas",
    "start": "next start",
    "generate": "opensaas generate",
    "db:update": "opensaas db update",
    "test:rag": "tsx --env-file-if-exists=.env test.ts",
    "test:e2e": "opensaas dev -- tsx test-e2e.ts"
  },
  "dependencies": {
    "@opensaas/stack-core": "workspace:*",
    "@opensaas/stack-rag": "workspace:*",
    "@opensaas/stack-ui": "workspace:*",
    "@prisma/orm-extension-pgvector": "8.0.0-rc.11",
    "@prisma/orm-postgres": "8.0.0-rc.11",
    "next": "^16.2.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@opensaas/stack-cli": "workspace:*",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "prisma": "8.0.0-rc.15",
    "tsx": "^4.23.11",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
