generator client {
  provider = "prisma-client"
  output   = "../.opensaas/prisma-client"
}

datasource db {
  provider = "sqlite"
}

model Product {
  id            String @id @default(cuid())
  name          String
  metadata      Json?
  settings      Json?
  configuration Json
}

model Article {
  id       String @id @default(cuid())
  title    String
  content  Json?
  taxonomy Json?
}
