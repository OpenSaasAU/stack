# Database
# `opensaas dev` starts the Dev database for this project, so DATABASE_URL is
# unset here. Set it to reach a Postgres of your own — that is the Database
# escape, and no Dev database starts.
# DATABASE_URL="postgresql://user:password@localhost:5432/rag_chatbot"

# OpenAI API Configuration
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# Optional: the chat model the /chat route answers with. Defaults to gpt-5-nano.
# OPENAI_CHAT_MODEL="gpt-4o-mini"

# Optional: an endpoint that speaks OpenAI's embeddings API, for Azure OpenAI or
# a compatible gateway. Unset reaches OpenAI itself. The embedding model is
# declared in opensaas.config.ts rather than here, because its dimension is the
# vector column's type and a mismatch is a migration, not a setting.
# OPENAI_BASE_URL="https://my-resource.openai.azure.com/openai/v1"
