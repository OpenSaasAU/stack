# Database
# `opensaas dev` starts the Dev database for this project, so DATABASE_URL is
# unset here. Set it to reach a Postgres of your own — that is the Database
# escape, and no Dev database starts.
# DATABASE_URL="postgresql://user:password@localhost:5432/opensaas_file_upload_demo"

# AWS S3 (optional - uncomment to use S3 storage)
# AWS_BUCKET="my-bucket-name"
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="your-access-key-id"
# AWS_SECRET_ACCESS_KEY="your-secret-access-key"

# Vercel Blob (optional - uncomment to use Vercel Blob storage)
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Better Auth (for authentication)
BETTER_AUTH_SECRET="your-secret-key-here"
BETTER_AUTH_URL="http://localhost:3000"
