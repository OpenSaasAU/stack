generator client {
  provider = "prisma-client"
  output   = "../.opensaas/prisma-client"
}

datasource db {
  provider = "sqlite"
}

model User {
  id     String @id @default(cuid())
  name   String
  email  String
  avatar Json?
  posts  Post[]
}

model Post {
  id         String  @id @default(cuid())
  title      String
  content    String?
  coverImage Json?
  attachment Json?
  authorId   String? @map("author")
  author     User?   @relation(fields: [authorId], references: [id])

  @@index([authorId])
}
