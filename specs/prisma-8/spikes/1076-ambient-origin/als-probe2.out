  create()                       compiled-before-await=0 total=1 origin-visible=1/1  -> LAZY (executes at await)
  update()                       compiled-before-await=0 total=2 origin-visible=2/2  -> LAZY (executes at await)
  updateAll()                    compiled-before-await=0 total=1 origin-visible=0/1  -> LAZY (executes at await)  [would be refused if awaited outside]
  delete()                       compiled-before-await=0 total=1 origin-visible=1/1  -> LAZY (executes at await)
  deleteAll()                    compiled-before-await=0 total=1 origin-visible=0/1  -> LAZY (executes at await)  [would be refused if awaited outside]
  upsert()                       compiled-before-await=1 total=1 origin-visible=1/1  -> EAGER (executes at call)
