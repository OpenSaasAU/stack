{
  "$schema": "https://turbo.build/schema.json",
  // Every package's own `build` writes `dist/.build-hash` by running this
  // script (see each package's `build` script and `assertDistFresh` in
  // `packages/*/vitest.global-setup.mjs`, issue #1302). It sits outside every
  // package's own directory, so without listing it here a change to its
  // hashing algorithm would not invalidate an unrelated package's cached
  // build — turbo would replay a `dist/.build-hash` written by the old
  // algorithm, and `assertDistFresh` would misreport it as stale.
  "globalDependencies": ["scripts/lib/dist-freshness.mjs", "scripts/lib/write-build-hash-cli.mjs"],
  "tasks": {
    "opensaas-stack-docs#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**"],
      "env": ["OPENAI_API_KEY"]
    },
    "opensaas-auth-example#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "tsconfig.tsbuildinfo"],
      "env": ["DATABASE_URL", "BETTER_AUTH_SECRET", "BETTER_AUTH_URL"]
    },
    "opensaas-mcp-example#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "tsconfig.tsbuildinfo"],
      "env": ["DATABASE_URL", "BETTER_AUTH_SECRET", "BETTER_AUTH_URL", "NEXT_PUBLIC_APP_URL"]
    },
    "opensaas-mcp-example#test": {
      "dependsOn": ["build"],
      "cache": false,
      "env": ["DATABASE_URL", "BETTER_AUTH_SECRET", "BETTER_AUTH_URL", "NEXT_PUBLIC_APP_URL"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "tsconfig.tsbuildinfo"],
      "env": ["DATABASE_URL"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"],
      "cache": false,
      "env": ["DATABASE_URL", "OPENAI_API_KEY"]
    },
    "test:coverage": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["coverage/**"],
      "env": ["DATABASE_URL", "OPENAI_API_KEY"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
