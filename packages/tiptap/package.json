{
  "name": "@opensaas/stack-tiptap",
  "version": "0.43.0",
  "description": "Tiptap rich text editor integration for OpenSaas Stack",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/__tests__",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fields": {
      "types": "./dist/fields/index.d.ts",
      "default": "./dist/fields/index.js"
    },
    "./components/register": {
      "types": "./dist/components/register.d.ts",
      "default": "./dist/components/register.js"
    }
  },
  "scripts": {
    "build": "tsc && npm run copy:css && node ../../scripts/lib/write-build-hash-cli.mjs",
    "copy:css": "node -e \"const fs=require('fs');fs.mkdirSync('dist/styles',{recursive:true});fs.copyFileSync('src/styles/tiptap.css','dist/styles/tiptap.css')\"",
    "dev": "tsc --watch",
    "typecheck": "tsc -p tsconfig.test.json",
    "clean": "rm -rf .turbo dist tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "opensaas",
    "tiptap",
    "rich-text",
    "editor",
    "nextjs"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenSaasAU/stack.git",
    "directory": "packages/tiptap"
  },
  "homepage": "https://stack.opensaas.au",
  "bugs": {
    "url": "https://github.com/OpenSaasAU/stack/issues"
  },
  "peerDependencies": {
    "@opensaas/stack-core": "^0",
    "@opensaas/stack-ui": "^0",
    "next": "^15.0.0 || ^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@opensaas/stack-core": "workspace:*",
    "@opensaas/stack-ui": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "5.0.3",
    "happy-dom": "^20.14.5",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "5.0.2"
  }
}
