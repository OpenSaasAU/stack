{
  "name": "@opensaas/stack-cli",
  "version": "0.40.0",
  "description": "CLI tools for OpenSaas Stack",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./generator": {
      "types": "./dist/generator/index.d.ts",
      "default": "./dist/generator/index.js"
    }
  },
  "bin": {
    "opensaas": "./bin/opensaas.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "clean": "rm -rf .turbo dist tsconfig.tsbuildinfo"
  },
  "keywords": [
    "opensaas",
    "cli",
    "nextjs",
    "prisma"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenSaasAU/stack.git",
    "directory": "packages/cli"
  },
  "homepage": "https://stack.opensaas.au",
  "bugs": {
    "url": "https://github.com/OpenSaasAU/stack/issues"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "@electric-sql/pglite-socket": "0.2.11",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opensaas/stack-core": "workspace:*",
    "@prisma/orm-postgres": "8.0.0-rc.8",
    "chalk": "^6.0.0",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "fs-extra": "^11.4.0",
    "glob": "^13.0.6",
    "jiti": "^2.7.0",
    "ora": "^9.4.1",
    "prisma": "8.0.0-rc.12",
    "prompts": "^2.4.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@prisma/orm-extension-pgvector": "8.0.0-rc.8",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.1.1",
    "@types/prompts": "^2.4.9",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "vitest": "^4.1.10"
  }
}
